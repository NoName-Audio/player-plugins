{
  "id": "example.hello",
  "name": "Hello Player",
  "version": "1.0.0",
  "apiVersion": 2,
  "description": "A native library example with settings, a page and playback events.",
  "platforms": [
    "macos",
    "windows",
    "linux"
  ],
  "permissions": [
    "ui",
    "settings",
    "playback.read"
  ],
  "contributions": [
    {
      "id": "home",
      "kind": "page",
      "label": "Hello Player"
    },
    {
      "id": "preferences",
      "kind": "settings",
      "label": "Hello Player"
    },
    {
      "id": "status",
      "kind": "player-widget",
      "label": "Hello Player",
      "slot": "player.status"
    }
  ],
  "attachments": [
    {
      "id": "album-greeting",
      "target": "AlbumCard",
      "position": "after",
      "view": "album-greeting",
      "order": 100
    }
  ],
  "author": {
    "name": "Player contributors",
    "url": "https://github.com/verncat"
  },
  "repository": "https://github.com/NoName-Audio/player-plugins",
  "homepage": "https://github.com/NoName-Audio/player-plugins/tree/main/examples/hello",
  "image": "assets/hello.png"
}
