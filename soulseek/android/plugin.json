{
  "id": "player.soulseek",
  "name": "Soulseek",
  "version": "1.0.3",
  "apiVersion": 2,
  "description": "Search, preview, download and replace music from Soulseek.",
  "platforms": [
    "android"
  ],
  "permissions": [
    "ui",
    "playback.read",
    "playback.control",
    "settings",
    "secrets",
    "library.import",
    "library.replace",
    "storage",
    "media.source",
    "native.android"
  ],
  "contributions": [
    {
      "id": "connection",
      "kind": "settings",
      "label": "Soulseek",
      "description": "Connection and credentials",
      "icon": "search"
    },
    {
      "id": "search",
      "kind": "search",
      "label": "Soulseek"
    },
    {
      "id": "replacement",
      "kind": "page",
      "label": "Find another version",
      "showInMenu": false,
      "icon": "search"
    },
    {
      "id": "find-replacement",
      "kind": "track-action",
      "label": "Find another version",
      "icon": "search"
    },
    {
      "id": "buffer",
      "kind": "player-widget",
      "label": "Soulseek",
      "slot": "player.status"
    }
  ],
  "author": {
    "name": "Player contributors",
    "url": "https://github.com/NoName-Audio/player/graphs/contributors"
  },
  "repository": "https://github.com/NoName-Audio/player-plugins",
  "homepage": "https://github.com/NoName-Audio/player-plugins/tree/main/soulseek",
  "image": "../assets/soulseek.png",
  "pollIntervalMs": 250
}
